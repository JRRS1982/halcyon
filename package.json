{
  "name": "halcyon",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix",
    "format": "biome format --write .",
    "postinstall": "prisma generate && simple-git-hooks",
    "db:seed": "tsx prisma/seed.ts",
    "check:mixed-schema": "tsx scripts/check-mixed-schema.ts",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "test": "jest",
    "check": "biome ci .",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "pnpm typecheck && pnpm check && pnpm test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:int": "DATABASE_URL=postgresql://postgres:postgres@localhost:5432/halcyon_test?schema=public DIRECT_URL=postgresql://postgres:postgres@localhost:5432/halcyon_test?schema=public jest --config jest.integration.config.ts --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm check"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@upstash/redis": "^1.38.4",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "styled-components": "^6.5.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/styled-components": "^5.1.36",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "prisma": "^7.10.0",
    "simple-git-hooks": "^2.14.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
