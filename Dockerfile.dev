FROM node:22-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
  openssl \
  && rm -rf /var/lib/apt/lists/*

# Install pnpm. Pin the version (not @latest) for reproducible builds — a
# floating @latest pulled pnpm 11, which is incompatible with this image's
# Node 20 (ERR_UNKNOWN_BUILTIN_MODULE). Keep in sync with the host pnpm.
RUN corepack enable && corepack prepare pnpm@10.24.0 --activate

# Set up Prisma
ENV PRISMA_CLI_QUERY_ENGINE_TYPE=library
ENV PRISMA_CLI_BINARY_TARGETS=debian-openssl-3.0.x

# Copy package files and prisma schema (needed for postinstall)
COPY package.json pnpm-lock.yaml ./
COPY prisma ./prisma

# Install dependencies (runs postinstall which generates Prisma client)
RUN pnpm install --frozen-lockfile

# Copy the rest of the application
COPY . .

# Generate Prisma client
RUN npx prisma generate

EXPOSE 3210

CMD ["pnpm", "dev"]