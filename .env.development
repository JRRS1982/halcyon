# COMMITTED ON PURPOSE — local values only. This file is tracked in the public
# repo; a .gitignore entry would NOT hide it. Never put a real credential here
# (prod pooler URL, Supabase keys, etc.) — those belong only in Vercel env vars
# and CI secrets. See README → "Which database am I hitting?".

# Database. Only host processes ever read this file's value: inside the
# container compose.yaml sets DATABASE_URL in the environment, and Next.js does
# not override an already-set variable from a .env file. So this has to be the
# host-reachable address — `db` resolves only on the Docker network, and a host
# `pnpm dev` pointed at it dies with `getaddrinfo EAI_AGAIN db` on the first
# query. The Docker-internal form is the commented one, for reference.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/halcyon?schema=public

# Inside the Docker network (what compose.yaml pins for the app service):
# DATABASE_URL=postgresql://postgres:postgres@db:5432/halcyon?schema=public

# Node
NODE_ENV=development
