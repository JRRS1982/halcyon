{
  "$schema": "https://biomejs.dev/schemas/1.5.0/schema.json",
  "files": {
    "ignore": [
      ".next",
      "node_modules",
      "dist",
      "build",
      "*.min.js",
      "coverage",
      "playwright-report",
      "test-results",
      ".claude",
      ".agents",
      ".pnpm-store",
      ".vscode"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "include": [
        "src/components/sheet/**",
        "src/app/budget/BudgetSheet.tsx",
        "src/app/balance/BalanceSheet.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    }
  ],
  "organizeImports": {
    "enabled": true
  }
}
