{
  "$schema": "https://biomejs.dev/schemas/1.5.0/schema.json",
  "files": {
    "ignore": [
      ".next",
      "node_modules",
      "dist",
      "build",
      "*.min.js",
      "coverage",
      "playwright-report",
      "test-results",
      ".claude",
      ".agents",
      ".pnpm-store"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "organizeImports": {
    "enabled": true
  }
}
