// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// Application-side profile row.
//
// `id` is the same uuid as `auth.users.id` (Supabase-managed). We don't declare
// `auth.users` here because it lives in the Supabase-managed `auth` schema, and
// Prisma cannot manage cross-schema FKs cleanly. The link is enforced either
// via a Postgres trigger on auth.users insert (preferred, atomic) or by the
// post-signup handler in the app.
//
// All Supabase-managed concerns (email, password hash, email verification,
// failed-login counters, OAuth identities, MFA) live on `auth.users` and are
// NOT mirrored here. Read them from the Supabase session.
model User {
  id           String     @id @db.Uuid
  username     String?
  name         String?
  image        String?
  timezone     String     @default("UTC")
  status       UserStatus @default(ACTIVE)
  lastActiveAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  periods       FinancialPeriod[]
  settings      UserSettings?
  categories    Category[]
  accounts      Account[]
  transactions  Transaction[]
  importBatches ImportBatch[]
  plans         Plan[]
}

// Per-user app preferences. Lazily upserted on first read — there is no
// guaranteed row for every user. Add columns here as new settings appear.
model UserSettings {
  userId              String   @id @db.Uuid
  currency            String   @default("GBP")
  numberFormat        String   @default("COMMA_0")
  // Defaults true: CSV import is the fastest route to a filled-in app, so it
  // shouldn't be something a new user has to discover in Settings first. Only
  // affects rows created from here on — existing users keep their own choice.
  transactionsEnabled Boolean  @default(true)
  // Defaults true alongside transactions: once statements are imported, money
  // moved between your own accounts is the first thing that misreads as income
  // or expense, so the section that nets it out should already be there.
  transfersEnabled    Boolean  @default(true)
  // Dashboard chart keys the user has switched off (empty = all shown).
  hiddenCharts        String[] @default([])
  // SYSTEM | LIGHT | DARK. Stored as text rather than an enum to match the
  // other preference columns here (currency, numberFormat), and validated at
  // the boundary by zod. SYSTEM means "write no data-theme attribute and let
  // prefers-color-scheme decide", which is why it is the default.
  themePreference     String   @default("SYSTEM")

  // Monthly reminder email. Off by default and never inferred from sign-up:
  // this is the one thing the app does that reaches the user unprompted, so it
  // is opt-in (UK GDPR Art. 6 consent) and the record of that consent is this
  // column plus its updatedAt.
  monthlyReminderEnabled Boolean   @default(false)
  // Day of the month to send on. Statements close on different days per bank,
  // so a fixed date would arrive before there was anything to import for a lot
  // of people. Constrained to 1 | 8 | 15 | 22 at the boundary by zod and by a
  // check constraint in the migration.
  monthlyReminderDay     Int       @default(1)
  // Last send, for idempotency: the cron runs daily, so this is what stops a
  // second run on the same date sending twice. Compared by calendar month.
  monthlyReminderSentAt  DateTime?
  // Bearer for the unsubscribe link. Random per user rather than a signed
  // userId, so unsubscribing never needs a secret in the URL's signature and
  // revoking is a single-row update. Null until the reminder is first enabled.
  unsubscribeToken       String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PeriodGranularity {
  WEEK
  MONTH
  QUARTER
}

enum ItemType {
  INCOME
  EXPENSE
  // Money out that is still yours: a contribution to an ASSET account.
  TRANSFER
  // Money out that reduces a debt: paid at a LIABILITY account.
  REPAYMENT
}

// What a Category can actually be — narrower than ItemType, which also
// carries TRANSFER/REPAYMENT for BudgetItem rows keyed on an Account instead.
enum CategoryKind {
  INCOME
  EXPENSE
}

// Relative to the named account, matching netTransfersForAccounts' convention:
// money in is positive, money out negative. NOT PlanEventDirection, whose
// INFLOW/OUTFLOW is relative to *you* — an inheritance is INFLOW there.
// TRANSFER rows carry this; REPAYMENT rows do not (always inward to the debt).
enum TransferDirection {
  INFLOW
  OUTFLOW
}

// The sub-heading a budget row sits under. One enum for both sides because
// the value sets do not overlap; a check constraint per table pins the
// section to the row's type (expense sections on EXPENSE, income on INCOME).
enum CategorySection {
  // expenses
  FIXED
  VARIABLE
  DISCRETIONARY
  // income
  SALARY
  SIDE_INCOME
  INVESTMENTS
  PENSIONS
  OTHER
}

// The sub-heading a balance-sheet row sits under. Asset-only PROPERTY in the
// UI — a "property liability" doesn't make sense; mortgage debt stays under
// Long-term liabilities. Kept on the shared enum to avoid splitting the type
// per side.
enum AccountSection {
  CURRENT
  MEDIUM_TERM
  LONG_TERM
  PROPERTY
  OTHER
}

// A budget / statement period belonging to one user.
// `userId` references public."User"(id), which mirrors auth.users(id) via the
// handle_new_user trigger. RLS adds a defence-in-depth boundary on top of
// app-level userId scoping (per ADR-002).
model FinancialPeriod {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  granularity PeriodGranularity @default(MONTH)
  startDate   DateTime          @db.Date
  endDate     DateTime          @db.Date
  label       String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        BudgetItem[]
  balanceItems BalanceItem[]

  @@unique([userId, granularity, startDate])
  @@index([userId])
}

// A single line item inside a period. A flat list — items belong to a period
// and a section, with no nesting.
model BudgetItem {
  id         String             @id @default(uuid()) @db.Uuid
  periodId   String             @db.Uuid
  // Links to the stable Category once the transactions feature exists. Nullable
  // so legacy/pre-migration rows and free-typed rows still parse; `label`
  // remains the source of truth when no category is linked, and a fallback even
  // when one is.
  categoryId String?            @db.Uuid
  type       ItemType
  // Null on TRANSFER/REPAYMENT rows, which key on an account instead.
  section    CategorySection?
  label      String
  budget     Decimal            @default(0) @db.Decimal(12, 2)
  actual     Decimal            @default(0) @db.Decimal(12, 2)
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?
  accountId  String?            @db.Uuid
  direction  TransferDirection?

  period         FinancialPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  linkedCategory Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account        Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([periodId, type, sortOrder])
  @@index([categoryId])
  @@index([accountId])
}

// A per-month observation of an account: value, note, provisional flag —
// nothing else; the partial unique index BalanceItem_period_account_live
// enforces one live value per account per month.
model BalanceItem {
  id          String    @id @default(uuid()) @db.Uuid
  periodId    String    @db.Uuid
  value       Decimal   @default(0) @db.Decimal(14, 2)
  notes       String?
  // True on rows cloned by copy-from (a previous month or the template):
  // the value is last month's number, shown provisionally until the user
  // confirms it by editing the value, which clears the flag.
  carriedOver Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  accountId   String    @db.Uuid

  period  FinancialPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  account Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// A stable, user-owned spending/earning category — the spine both the budget
// and transactions hang off (per docs/superpowers/specs). Present regardless
// of whether the transactions feature is enabled. `label` is mutable so a
// rename touches one row and propagates by id; `type` + `section` mirror
// BudgetItem so a category carries its grouping. Categories are curated in
// Settings (rename / merge / archive). Soft-deleted via deletedAt.
model Category {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  type      CategoryKind
  section   CategorySection
  label     String
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetItems  BudgetItem[]
  transactions Transaction[]
  planIncomes  PlanIncome[]
  planExpenses PlanExpense[]

  @@index([userId, type, sortOrder])
}

// Column-less — the TS grouping kindOf returns.
enum AccountKind {
  ASSET
  LIABILITY
}

// The account type the user picks in the Add drawer — the ONE stored fact.
// kind (asset/liability) and wrapper (tax treatment) are computed from it in
// code (kindOf/wrapperOf in src/lib/accounts/accountDraft.ts), never stored
// as facts.
enum AccountType {
  CURRENT_ACCOUNT
  SAVINGS
  CASH_ISA
  STOCKS_ISA
  SIPP
  FINAL_SALARY
  GIA
  PROPERTY
  OTHER_ASSET
  MORTGAGE
  CREDIT_CARD
  LOAN
  OVERDRAFT
  OTHER_DEBT
}

// The durable registry for everything a user owns or owes — a bank account,
// an ISA, a mortgage. Picked or created at import time and managed in
// Settings; also the identity a BalanceItem observes month to month and a
// PlanAsset/PlanLiability attaches its assumptions to.
//
// NOTE: the live-row uniqueness on BalanceItem (one value per account per
// month) is enforced by a partial unique index — "BalanceItem_period_account_live"
// on ("periodId", "accountId") WHERE "deletedAt" IS NULL — added in the
// add_account_type migration. Prisma cannot express a partial index, so it is
// not declared as an @@unique here; see that migration for the DDL.
model Account {
  id                    String         @id @default(uuid()) @db.Uuid
  userId                String         @db.Uuid
  name                  String
  type                  AccountType
  // Where the account sits on the balance sheet. Defaulted from type at
  // creation, user-editable, and a fact about the account, not the month.
  section               AccountSection
  sortOrder             Int            @default(0)
  // The user's choice, not a derived fact: plenty of mortgage providers issue
  // statements. `kindOf(type)` supplies only the initial default at creation
  // time and never overrides it afterwards. Gates the transactions page's
  // *importable* account list — src/app/(app)/transactions/page.tsx queries it separately
  // and it feeds only the import target picker, quick-add and the ledger's
  // account filter. It deliberately does NOT gate transfer targets or the
  // ledger's transferAccountId → name resolution: those read from the page's
  // second, unfiltered account query (see CategoryCombobox's
  // `transferAccounts` prop), so an account excluded from import (e.g. a
  // mortgage) can still be a transfer counterparty and still displays by
  // name on rows that already point at it. No picker filters on `kind`.
  canImportTransactions Boolean        @default(true)
  // Mortgage ↔ property. A fact about the house, not about one plan, which is
  // why it lives here rather than on PlanLiability.
  linkedAccountId       String?        @unique @db.Uuid
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]   @relation("AccountTransactions")
  transfersFrom   Transaction[]   @relation("TransferCounterparty")
  importBatches   ImportBatch[]
  balanceItems    BalanceItem[]
  budgetItems     BudgetItem[]
  linkedAccount   Account?        @relation("AccountLink", fields: [linkedAccountId], references: [id], onDelete: SetNull)
  linkedBy        Account?        @relation("AccountLink")
  planAssets      PlanAsset[]
  planLiabilities PlanLiability[]
  terms           AccountTerms?

  @@index([userId])
}

// The projection's parameters for one account. Separate from Account because
// every other feature — the ledger, transactions, the budget's anchors, the
// sheet's grouping — reads Account constantly and none of them care how a
// balance evolves.
//
// Every column is nullable and blank means "take the default", never
// "unknown": a property with no feePct has no platform charges, which is true.
// Which parameters a given type PROMPTS for is declared in ACCOUNT_TYPES
// (src/lib/accounts/accountDraft.ts), not fenced here — a CHECK passes on NULL.
model AccountTerms {
  // The account's own id, so 1:1 needs no separate unique index.
  accountId String @id @db.Uuid

  // Growth side.
  expectedReturnPct Decimal? @db.Decimal(5, 2)
  feePct            Decimal? @db.Decimal(5, 2)
  // An age, not a date, unlike endDate below: a scheme's access age is 57
  // whoever you are, so it needs no date of birth to mean anything.
  minAccessAge      Int?
  // A final-salary entitlement, e.g. 12000 for £12,000/yr. Setting it makes
  // this account an income from `endDate` and its balance display-only — see
  // the DB pension double-count in the spec.
  annualIncome      Decimal? @db.Decimal(12, 2)

  // Debt side. `interestOnly` deliberately carries no `is` prefix so the name
  // matches PlanLiability.interestOnly and Sync stays a mechanical copy.
  interestPct  Decimal?  @db.Decimal(5, 2)
  interestOnly Boolean   @default(false)
  revisionDate DateTime? @db.Date
  revisionRate Decimal?  @db.Decimal(5, 2)

  // When this stops being a balance: a mortgage repaid, a final-salary pension
  // converted to an income. A date, not an age — "ends 2049" is the answer a
  // person actually has, and the account does not know their date of birth.
  endDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// One CSV import run. Groups the transactions it created so the whole import
// can be reversed: the batch's live transactions are soft-deleted and the
// batch is stamped reversedAt (which retires it from the reversal dropdown).
// Imports made before this model existed have no batch and can't be reversed.
model ImportBatch {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  accountId  String    @db.Uuid
  fileName   String?
  createdAt  DateTime  @default(now())
  reversedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, createdAt])
}

// An imported (or hand-entered) bank transaction. `amount` is stored SIGNED;
// the linked Category's type routes whether it counts as income or expense
// (see src/lib/transactions/actual.ts). No periodId — the `date` derives the
// budget month on the fly, so a category's monthly `actual` is a grouped
// aggregate keyed by (userId, categoryId, date-range). categoryId is nullable:
// uncategorized spend is surfaced, never auto-bucketed. Soft-deleted.
model Transaction {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  accountId         String    @db.Uuid
  categoryId        String?   @db.Uuid
  transferAccountId String?   @db.Uuid
  // The import run that created this row; null for pre-batch imports and
  // anything not created by a CSV import.
  importBatchId     String?   @db.Uuid
  date              DateTime  @db.Date
  amount            Decimal   @db.Decimal(14, 2)
  description       String
  note              String?
  // Extra CSV columns the user chose to keep at import time, keyed by the
  // column's header label (e.g. {"Type": "DD", "Reference": "000123"}).
  // Machine-kept import metadata — `note` stays human-written.
  extra             Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account      @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // The other side of a transfer. App-level guards block deleting an account
  // still referenced here (accounts are soft-deleted), so onDelete: Restrict is
  // belt-and-braces defence that is never expected to fire.
  transferAccount Account?     @relation("TransferCounterparty", fields: [transferAccountId], references: [id], onDelete: Restrict)
  importBatch     ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  // (userId, accountId, date) → pagination + the dedup-fingerprint day lookup,
  // and the per-account transfer aggregate (filtered transferAccountId IS NOT NULL).
  // (userId, categoryId, date) → the per-category-per-month actual aggregate.
  // (importBatchId) → the reverse-import bulk update + live batch counts.
  @@index([userId, accountId, date])
  @@index([userId, categoryId, date])
  @@index([importBatchId])
}

// ─── Life-planning models ──────────────────────────────────────────────────

enum PlanAssetWrapper {
  PENSION
  ISA
  GIA
  CASH
  PROPERTY
  DB_PENSION
  OTHER
}

enum PlanIncomeKind {
  SALARY
  SELF_EMPLOYMENT
  STATE_PENSION
  DB_PENSION
  RENTAL
  OTHER
}

enum PlanEventDirection {
  INFLOW
  OUTFLOW
}

enum PlanEventKind {
  MANUAL
  PROPERTY_SALE
}

enum GrowthKind {
  INFLATION
  FIXED
  NONE
}

// Which UK income tax regime the user is taxed under. Wales sets no separate
// rates; Northern Ireland follows rest-of-UK.
enum TaxRegime {
  RUK
  SCOTLAND
}

model Plan {
  id                        String    @id @default(uuid()) @db.Uuid
  userId                    String    @db.Uuid
  name                      String    @default("My plan")
  dateOfBirth               DateTime  @db.Date
  retirementAge             Int
  planToAge                 Int       @default(95)
  inflationPct              Decimal   @default(2.5) @db.Decimal(5, 2)
  defaultReturnPct          Decimal   @default(5) @db.Decimal(5, 2)
  returnSpreadPct           Decimal   @default(0) @db.Decimal(5, 2)
  taxRegime                 TaxRegime @default(RUK)
  // Whether tax thresholds rise with inflation beyond the last known tax year.
  // Default true: frozen thresholds are accurate short-term but implausible over
  // a fifty-year projection — at 2.5% inflation a £50k salary becomes ~£134k
  // nominal against a higher-rate threshold still at £50,270.
  thresholdsInflationLinked Boolean   @default(true)
  statePensionAge           Int?
  statePensionAnnual        Decimal?  @db.Decimal(12, 2)
  expectedDeathAge          Int?      @default(90)
  isPrimary                 Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets      PlanAsset[]
  liabilities PlanLiability[]
  incomes     PlanIncome[]
  expenses    PlanExpense[]
  events      PlanEvent[]

  @@index([userId])
}

model PlanAsset {
  id                  String           @id @default(uuid()) @db.Uuid
  planId              String           @db.Uuid
  label               String
  wrapper             PlanAssetWrapper @default(OTHER)
  openingValue        Decimal          @default(0) @db.Decimal(14, 2)
  expectedReturnPct   Decimal?         @db.Decimal(5, 2)
  feePct              Decimal          @default(0) @db.Decimal(5, 2)
  // Monthly, not annual: the budget stores monthly and comparing across units
  // means dividing by 12, which has no exact decimal form — £10,000/yr reads
  // back as £9,999.96 and reports as changed forever. assets.ts does the × 12.
  monthlyContribution Decimal          @default(0) @db.Decimal(12, 2)
  contributionEndAge  Int?
  minAccessAge        Int?
  // A final-salary entitlement copied from AccountTerms.annualIncome, and the
  // age its endDate converts to. `endAge` lives only on PlanLiability, so an
  // ASSET conversion date needs its own column.
  annualIncome        Decimal?         @db.Decimal(12, 2)
  incomeFromAge       Int?
  drawdownPriority    Int              @default(0)
  sortOrder           Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?
  // The account this row mirrors. Null means a plan-only row — something the
  // user invented that is not on their balance sheet. Replaces
  // sourceBalanceItemId, which pointed at a single month's observation and so
  // could only ever seed once.
  accountId           String?          @db.Uuid
  account             Account?         @relation(fields: [accountId], references: [id], onDelete: SetNull)

  plan       Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  mortgage   PlanLiability? @relation("MortgageProperty")
  saleEvents PlanEvent[]    @relation("EventProperty")

  // One row per account per plan. Sync resolves what to add outside the
  // transaction that adds it, so two concurrent presses can both decide to add
  // the same account; only the database can refuse the second. Plan-only rows
  // (accountId null) are unaffected — Postgres treats NULLs as distinct.
  // Soft-deleting a row clears its link (see plan/actions.ts), so a tombstone
  // never occupies the account's slot.
  @@unique([planId, accountId])
  @@index([planId])
  @@index([accountId])
}

model PlanLiability {
  id               String    @id @default(uuid()) @db.Uuid
  planId           String    @db.Uuid
  label            String
  openingBalance   Decimal   @default(0) @db.Decimal(14, 2)
  interestPct      Decimal   @default(0) @db.Decimal(5, 2)
  interestOnly     Boolean   @default(false)
  revisionRate     Decimal?  @db.Decimal(5, 2)
  revisionAge      Int?
  monthlyRepayment Decimal   @default(0) @db.Decimal(12, 2)
  startAge         Int?
  endAge           Int?
  linkedAssetId    String?   @unique @db.Uuid
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  // The account this row mirrors. Null means a plan-only row — something the
  // user invented that is not on their balance sheet. Replaces
  // sourceBalanceItemId, which pointed at a single month's observation and so
  // could only ever seed once.
  accountId        String?   @db.Uuid
  account          Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  plan             Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  linkedAsset      PlanAsset?   @relation("MortgageProperty", fields: [linkedAssetId], references: [id], onDelete: SetNull)
  repaymentExpense PlanExpense? @relation("LiabilityRepaymentExpense")

  // See PlanAsset: one row per account per plan.
  @@unique([planId, accountId])
  @@index([planId])
  @@index([accountId])
}

model PlanIncome {
  id           String         @id @default(uuid()) @db.Uuid
  planId       String         @db.Uuid
  label        String
  kind         PlanIncomeKind
  annualAmount Decimal        @default(0) @db.Decimal(12, 2)
  startAge     Int?
  endAge       Int?
  growthKind   GrowthKind     @default(INFLATION)
  growthPct    Decimal?       @db.Decimal(5, 2)
  taxable      Boolean        @default(true)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  categoryId   String?        @db.Uuid

  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // See PlanAsset: one row per category per plan.
  @@unique([planId, categoryId])
  @@index([planId])
  @@index([categoryId])
}

model PlanExpense {
  id              String           @id @default(uuid()) @db.Uuid
  planId          String           @db.Uuid
  label           String
  // Expense sections only (check constraint). Null for a plan-only row.
  section         CategorySection?
  annualAmount    Decimal          @default(0) @db.Decimal(12, 2)
  startAge        Int?
  endAge          Int?
  inflationLinked Boolean          @default(true)
  categoryId      String?          @db.Uuid
  liabilityId     String?          @unique @db.Uuid
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  plan           Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  liability      PlanLiability? @relation("LiabilityRepaymentExpense", fields: [liabilityId], references: [id], onDelete: SetNull)
  linkedCategory Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // See PlanAsset: one row per category per plan.
  @@unique([planId, categoryId])
  @@index([planId])
  @@index([categoryId])
}

model PlanEvent {
  id        String             @id @default(uuid()) @db.Uuid
  planId    String             @db.Uuid
  label     String
  age       Int
  direction PlanEventDirection
  amount    Decimal            @default(0) @db.Decimal(14, 2)
  kind      PlanEventKind      @default(MANUAL)
  assetId   String?            @db.Uuid
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?

  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  saleAsset PlanAsset? @relation("EventProperty", fields: [assetId], references: [id], onDelete: SetNull)

  @@index([planId])
}
