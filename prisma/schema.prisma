// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// Application-side profile row.
//
// `id` is the same uuid as `auth.users.id` (Supabase-managed). We don't declare
// `auth.users` here because it lives in the Supabase-managed `auth` schema, and
// Prisma cannot manage cross-schema FKs cleanly. The link is enforced either
// via a Postgres trigger on auth.users insert (preferred, atomic) or by the
// post-signup handler in the app.
//
// All Supabase-managed concerns (email, password hash, email verification,
// failed-login counters, OAuth identities, MFA) live on `auth.users` and are
// NOT mirrored here. Read them from the Supabase session.
model User {
  id           String     @id @db.Uuid
  username     String?
  name         String?
  image        String?
  timezone     String     @default("UTC")
  status       UserStatus @default(ACTIVE)
  lastActiveAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  periods  FinancialPeriod[]
  settings UserSettings?
}

// Per-user app preferences. Lazily upserted on first read — there is no
// guaranteed row for every user. Add columns here as new settings appear.
model UserSettings {
  userId       String   @id @db.Uuid
  currency     String   @default("USD")
  numberFormat String   @default("COMMA_0")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PeriodGranularity {
  WEEK
  MONTH
  QUARTER
  YEAR
}

enum ItemType {
  INCOME
  EXPENSE
}

// Expense grouping buckets. Only set on top-level EXPENSE items; null for
// income and for nested children (which inherit their top-level ancestor's
// bucket visually).
enum ExpenseCategory {
  FIXED
  VARIABLE
  DISCRETIONARY
}

enum BalanceItemType {
  ASSET
  LIABILITY
}

enum BalanceItemCategory {
  CURRENT
  LONG_TERM
  OTHER
}

// A budget / statement period belonging to one user.
// `userId` references public."User"(id), which mirrors auth.users(id) via the
// handle_new_user trigger. RLS adds a defence-in-depth boundary on top of
// app-level userId scoping (per ADR-002).
model FinancialPeriod {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  granularity PeriodGranularity @default(MONTH)
  startDate   DateTime          @db.Date
  endDate     DateTime          @db.Date
  label       String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        FinancialItem[]
  balanceItems BalanceItem[]

  @@unique([userId, granularity, startDate])
  @@index([userId])
}

// A single line item inside a period. Self-references for hierarchical
// sub-rows (Salary → His salary / Her salary). UI caps depth at 3.
model FinancialItem {
  id           String           @id @default(uuid()) @db.Uuid
  periodId     String           @db.Uuid
  type         ItemType
  parentItemId String?          @db.Uuid
  category     ExpenseCategory?
  label        String
  budget       Decimal          @default(0) @db.Decimal(12, 2)
  actual       Decimal          @default(0) @db.Decimal(12, 2)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  period   FinancialPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  parent   FinancialItem?  @relation("ItemHierarchy", fields: [parentItemId], references: [id], onDelete: Cascade)
  children FinancialItem[] @relation("ItemHierarchy")

  @@index([periodId, type, parentItemId, sortOrder])
}

// Balance sheet line items belonging to a FinancialPeriod (shared with the
// budget so /budget and /balance for a given month touch the same period
// row). Flat — no parent self-reference — because the three category
// buckets (CURRENT / LONG_TERM / OTHER) replace hierarchy. Notes is free-
// form context attached to the row.
model BalanceItem {
  id        String              @id @default(uuid()) @db.Uuid
  periodId  String              @db.Uuid
  type      BalanceItemType
  category  BalanceItemCategory
  label     String
  value     Decimal             @default(0) @db.Decimal(14, 2)
  notes     String?
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?

  period FinancialPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId, type, category, sortOrder])
}
