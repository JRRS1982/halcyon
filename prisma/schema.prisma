// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// Application-side profile row.
//
// `id` is the same uuid as `auth.users.id` (Supabase-managed). We don't declare
// `auth.users` here because it lives in the Supabase-managed `auth` schema, and
// Prisma cannot manage cross-schema FKs cleanly. The link is enforced either
// via a Postgres trigger on auth.users insert (preferred, atomic) or by the
// post-signup handler in the app.
//
// All Supabase-managed concerns (email, password hash, email verification,
// failed-login counters, OAuth identities, MFA) live on `auth.users` and are
// NOT mirrored here. Read them from the Supabase session.
model User {
  id           String     @id @db.Uuid
  username     String?
  name         String?
  image        String?
  timezone     String     @default("UTC")
  status       UserStatus @default(ACTIVE)
  lastActiveAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  periods              FinancialPeriod[]
  settings             UserSettings?
  budgetTemplateItems  BudgetTemplateItem[]
  balanceTemplateItems BalanceTemplateItem[]
  categories           Category[]
  accounts             Account[]
  transactions         Transaction[]
  importBatches        ImportBatch[]
  plans                Plan[]
}

// Per-user app preferences. Lazily upserted on first read — there is no
// guaranteed row for every user. Add columns here as new settings appear.
model UserSettings {
  userId              String   @id @db.Uuid
  currency            String   @default("GBP")
  numberFormat        String   @default("COMMA_0")
  // Defaults true: CSV import is the fastest route to a filled-in app, so it
  // shouldn't be something a new user has to discover in Settings first. Only
  // affects rows created from here on — existing users keep their own choice.
  transactionsEnabled Boolean  @default(true)
  transfersEnabled    Boolean  @default(false)
  // Dashboard chart keys the user has switched off (empty = all shown).
  hiddenCharts        String[] @default([])
  planVisible         Boolean  @default(true)
  // SYSTEM | LIGHT | DARK. Stored as text rather than an enum to match the
  // other preference columns here (currency, numberFormat), and validated at
  // the boundary by zod. SYSTEM means "write no data-theme attribute and let
  // prefers-color-scheme decide", which is why it is the default.
  themePreference     String   @default("SYSTEM")

  // Monthly reminder email. Off by default and never inferred from sign-up:
  // this is the one thing the app does that reaches the user unprompted, so it
  // is opt-in (UK GDPR Art. 6 consent) and the record of that consent is this
  // column plus its updatedAt.
  monthlyReminderEnabled Boolean   @default(false)
  // Day of the month to send on. Statements close on different days per bank,
  // so a fixed date would arrive before there was anything to import for a lot
  // of people. Constrained to 1 | 8 | 15 | 22 at the boundary by zod and by a
  // check constraint in the migration.
  monthlyReminderDay     Int       @default(1)
  // Last send, for idempotency: the cron runs daily, so this is what stops a
  // second run on the same date sending twice. Compared by calendar month.
  monthlyReminderSentAt  DateTime?
  // Bearer for the unsubscribe link. Random per user rather than a signed
  // userId, so unsubscribing never needs a secret in the URL's signature and
  // revoking is a single-row update. Null until the reminder is first enabled.
  unsubscribeToken       String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PeriodGranularity {
  WEEK
  MONTH
  QUARTER
  YEAR
}

enum ItemType {
  INCOME
  EXPENSE
}

// Expense grouping buckets. Only set on top-level EXPENSE items; null for
// income and for nested children (which inherit their top-level ancestor's
// bucket visually).
enum ExpenseCategory {
  FIXED
  VARIABLE
  DISCRETIONARY
}

// Income grouping buckets. Only set on top-level INCOME items; null for
// expenses and for nested children.
enum IncomeCategory {
  SALARY
  SIDE_INCOME
  INVESTMENTS
  PENSIONS
  OTHER
}

enum BalanceItemType {
  ASSET
  LIABILITY
}

enum BalanceItemCategory {
  CURRENT
  MEDIUM_TERM
  LONG_TERM
  // Asset-only in the UI — a "property liability" doesn't make sense; mortgage
  // debt stays under Long-term liabilities. Kept on the shared enum to avoid
  // splitting the type per side.
  PROPERTY
  OTHER
}

// A budget / statement period belonging to one user.
// `userId` references public."User"(id), which mirrors auth.users(id) via the
// handle_new_user trigger. RLS adds a defence-in-depth boundary on top of
// app-level userId scoping (per ADR-002).
model FinancialPeriod {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  granularity PeriodGranularity @default(MONTH)
  startDate   DateTime          @db.Date
  endDate     DateTime          @db.Date
  label       String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        FinancialItem[]
  balanceItems BalanceItem[]

  @@unique([userId, granularity, startDate])
  @@index([userId])
}

// A single line item inside a period. A flat list — items belong to a period
// and a category bucket, with no nesting.
model FinancialItem {
  id             String           @id @default(uuid()) @db.Uuid
  periodId       String           @db.Uuid
  // Links to the stable Category once the transactions feature exists. Nullable
  // so legacy/pre-migration rows and free-typed rows still parse; `label`
  // remains the source of truth when no category is linked, and a fallback even
  // when one is.
  categoryId     String?          @db.Uuid
  type           ItemType
  category       ExpenseCategory?
  incomeCategory IncomeCategory?
  label          String
  budget         Decimal          @default(0) @db.Decimal(12, 2)
  actual         Decimal          @default(0) @db.Decimal(12, 2)
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  period         FinancialPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  linkedCategory Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([periodId, type, sortOrder])
  @@index([categoryId])
}

// Balance sheet line items belonging to a FinancialPeriod (shared with the
// budget so /budget and /balance for a given month touch the same period
// row). Flat — no parent self-reference — because the three category
// buckets (CURRENT / LONG_TERM / OTHER) replace hierarchy. Notes is free-
// form context attached to the row.
model BalanceItem {
  id        String              @id @default(uuid()) @db.Uuid
  periodId  String              @db.Uuid
  type      BalanceItemType
  category  BalanceItemCategory
  label     String
  value     Decimal             @default(0) @db.Decimal(14, 2)
  notes     String?
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?

  period FinancialPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId, type, category, sortOrder])
}

// A reusable budget template row, owned directly by a user (not tied to a
// period). "Save this month as template" snapshots a month into these;
// "Copy from → Template" seeds a month from them. A flat list — no `actual`,
// a template is the plan, not spending.
model BudgetTemplateItem {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  type           ItemType
  category       ExpenseCategory?
  incomeCategory IncomeCategory?
  label          String
  budget         Decimal          @default(0) @db.Decimal(12, 2)
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, sortOrder])
}

// A reusable balance-sheet template row, owned directly by a user. Flat, like
// BalanceItem. "Copy from → Template" seeds a month's balance from these.
model BalanceTemplateItem {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  type      BalanceItemType
  category  BalanceItemCategory
  label     String
  value     Decimal             @default(0) @db.Decimal(14, 2)
  notes     String?
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, category, sortOrder])
}

// A stable, user-owned spending/earning category — the spine both the budget
// and transactions hang off (per docs/superpowers/specs). Present regardless
// of whether the transactions feature is enabled. `label` is mutable so a
// rename touches one row and propagates by id; `type` + bucket mirror
// FinancialItem so a category carries its grouping. Categories are curated in
// Settings (rename / merge / archive). Soft-deleted via deletedAt.
model Category {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  type           ItemType
  category       ExpenseCategory?
  incomeCategory IncomeCategory?
  label          String
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  financialItems FinancialItem[]
  transactions   Transaction[]

  @@index([userId, type, sortOrder])
}

// A bank account a statement was imported from. Picked or created at import
// time; managed in Settings. Lightweight by design — v1 has no per-account
// balances, just a label to scope and filter transactions (and dedup).
model Account {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  name      String
  type      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[] @relation("AccountTransactions")
  transfersFrom Transaction[] @relation("TransferCounterparty")
  importBatches ImportBatch[]

  @@index([userId])
}

// One CSV import run. Groups the transactions it created so the whole import
// can be reversed: the batch's live transactions are soft-deleted and the
// batch is stamped reversedAt (which retires it from the reversal dropdown).
// Imports made before this model existed have no batch and can't be reversed.
model ImportBatch {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  accountId  String    @db.Uuid
  fileName   String?
  createdAt  DateTime  @default(now())
  reversedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, createdAt])
}

// An imported (or hand-entered) bank transaction. `amount` is stored SIGNED;
// the linked Category's type routes whether it counts as income or expense
// (see src/lib/transactions/actual.ts). No periodId — the `date` derives the
// budget month on the fly, so a category's monthly `actual` is a grouped
// aggregate keyed by (userId, categoryId, date-range). categoryId is nullable:
// uncategorized spend is surfaced, never auto-bucketed. Soft-deleted.
model Transaction {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  accountId         String    @db.Uuid
  categoryId        String?   @db.Uuid
  transferAccountId String?   @db.Uuid
  // The import run that created this row; null for pre-batch imports and
  // anything not created by a CSV import.
  importBatchId     String?   @db.Uuid
  date              DateTime  @db.Date
  amount            Decimal   @db.Decimal(14, 2)
  description       String
  note              String?
  // Extra CSV columns the user chose to keep at import time, keyed by the
  // column's header label (e.g. {"Type": "DD", "Reference": "000123"}).
  // Machine-kept import metadata — `note` stays human-written.
  extra             Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // The other side of a transfer. App-level guards block deleting an account
  // still referenced here (accounts are soft-deleted), so onDelete: Restrict is
  // belt-and-braces defence that is never expected to fire.
  transferAccount Account? @relation("TransferCounterparty", fields: [transferAccountId], references: [id], onDelete: Restrict)
  importBatch     ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  // (userId, accountId, date) → pagination + the dedup-fingerprint day lookup,
  // and the per-account transfer aggregate (filtered transferAccountId IS NOT NULL).
  // (userId, categoryId, date) → the per-category-per-month actual aggregate.
  // (importBatchId) → the reverse-import bulk update + live batch counts.
  @@index([userId, accountId, date])
  @@index([userId, categoryId, date])
  @@index([importBatchId])
}

// ─── Life-planning models ──────────────────────────────────────────────────

enum PlanAssetWrapper {
  PENSION
  ISA
  GIA
  CASH
  PROPERTY
  DB_PENSION
  OTHER
}

enum PlanIncomeKind {
  SALARY
  SELF_EMPLOYMENT
  STATE_PENSION
  DB_PENSION
  RENTAL
  OTHER
}

enum PlanEventDirection {
  INFLOW
  OUTFLOW
}

enum PlanEventKind {
  MANUAL
  PROPERTY_SALE
}

enum GrowthKind {
  INFLATION
  FIXED
  NONE
}

model Plan {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  name               String   @default("My plan")
  dateOfBirth        DateTime @db.Date
  retirementAge      Int
  planToAge          Int      @default(95)
  inflationPct       Decimal  @default(2.5) @db.Decimal(5, 2)
  defaultReturnPct   Decimal  @default(5) @db.Decimal(5, 2)
  returnSpreadPct    Decimal  @default(0) @db.Decimal(5, 2)
  blendedTaxRatePct  Decimal  @default(20) @db.Decimal(5, 2)
  statePensionAge    Int?
  statePensionAnnual Decimal? @db.Decimal(12, 2)
  expectedDeathAge   Int?     @default(90)
  isPrimary          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets      PlanAsset[]
  liabilities PlanLiability[]
  incomes     PlanIncome[]
  expenses    PlanExpense[]
  events      PlanEvent[]

  @@index([userId])
}

model PlanAsset {
  id                  String           @id @default(uuid()) @db.Uuid
  planId              String           @db.Uuid
  label               String
  wrapper             PlanAssetWrapper @default(OTHER)
  openingValue        Decimal          @default(0) @db.Decimal(14, 2)
  expectedReturnPct   Decimal?         @db.Decimal(5, 2)
  feePct              Decimal          @default(0) @db.Decimal(5, 2)
  annualContribution  Decimal          @default(0) @db.Decimal(12, 2)
  contributionEndAge  Int?
  minAccessAge        Int?
  drawdownPriority    Int              @default(0)
  sourceBalanceItemId String?          @db.Uuid
  sortOrder           Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  plan       Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  mortgage   PlanLiability? @relation("MortgageProperty")
  saleEvents PlanEvent[]    @relation("EventProperty")
  @@index([planId])
}

model PlanLiability {
  id               String   @id @default(uuid()) @db.Uuid
  planId           String   @db.Uuid
  label            String
  openingBalance   Decimal  @default(0) @db.Decimal(14, 2)
  interestPct      Decimal  @default(0) @db.Decimal(5, 2)
  interestOnly     Boolean  @default(false)
  monthlyRepayment Decimal  @default(0) @db.Decimal(12, 2)
  startAge         Int?
  endAge           Int?
  linkedAssetId    String?  @unique @db.Uuid
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  plan             Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  linkedAsset      PlanAsset?   @relation("MortgageProperty", fields: [linkedAssetId], references: [id], onDelete: SetNull)
  repaymentExpense PlanExpense? @relation("LiabilityRepaymentExpense")
  @@index([planId])
}

model PlanIncome {
  id           String         @id @default(uuid()) @db.Uuid
  planId       String         @db.Uuid
  label        String
  kind         PlanIncomeKind
  annualAmount Decimal        @default(0) @db.Decimal(12, 2)
  startAge     Int?
  endAge       Int?
  growthKind   GrowthKind     @default(INFLATION)
  growthPct    Decimal?       @db.Decimal(5, 2)
  taxable      Boolean        @default(true)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  @@index([planId])
}

model PlanExpense {
  id               String           @id @default(uuid()) @db.Uuid
  planId           String           @db.Uuid
  label            String
  category         ExpenseCategory?
  annualAmount     Decimal          @default(0) @db.Decimal(12, 2)
  startAge         Int?
  endAge           Int?
  inflationLinked  Boolean          @default(true)
  sourceCategoryId String?          @db.Uuid
  liabilityId      String?          @unique @db.Uuid
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  plan      Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  liability PlanLiability? @relation("LiabilityRepaymentExpense", fields: [liabilityId], references: [id], onDelete: SetNull)
  @@index([planId])
}

model PlanEvent {
  id        String             @id @default(uuid()) @db.Uuid
  planId    String             @db.Uuid
  label     String
  age       Int
  direction PlanEventDirection
  amount    Decimal            @default(0) @db.Decimal(14, 2)
  kind      PlanEventKind      @default(MANUAL)
  assetId   String?            @db.Uuid
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?

  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  saleAsset PlanAsset? @relation("EventProperty", fields: [assetId], references: [id], onDelete: SetNull)
  @@index([planId])
}
