# Dependencies
/node_modules
/.pnp
.pnp.js
# Local pnpm content-addressable store (created when running pnpm inside the
# dev container, which mounts the repo). It's a package cache, not source.
/.pnpm-store

# Testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache
/.playwright-mcp/

# Next.js
/.next/
/out/
# Managed by Next.js (regenerated by `next typegen`); never edit or commit.
next-env.d.ts

# TypeScript incremental build cache
*.tsbuildinfo

# Visual companion mockups (brainstorming skill)
.superpowers

# Superpowers planning/spec artifacts (kept locally, not tracked; curated
# feature docs live in docs/features/ instead)
/docs/superpowers/

# Playwright auth session state (written by capture-shots.mjs — never commit)
/.auth/

# Claude Code worktrees (transient; the rest of .claude/ stays committable)
.claude/worktrees/

# Production
/build

# Environment files
#
# A glob with explicit exceptions, not a list of names. Enumerating four exact
# spellings meant any env file someone later created under a fifth —
# .env.staging, .env.backup, .env.supabase — was untracked but visible, and one
# `git add .` would publish it. This repo is public, so that is the whole
# distance between a local secret and a leaked one.
.env*
!.env.example
!.env.development

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local development
.DS_Store
*.pem

# IDE/Editor
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# .env.development is committed on purpose (local docker values only) — see the
# header in that file. Do NOT add it here: it is already tracked, so a gitignore
# entry has no effect on it and only misleads.

# Vercel CLI link + build state
.vercel/
